# Chave da API Anthropic. Copie para .env (ignorado pelo git) e preencha.
ANTHROPIC_API_KEY=

# Servico HTTP (compose). PORT = porta publica do chat; PORT_INTERNA = /preparar e /validar,
# so para a rede do compose (nao publicar no host).
# PORT=3000
# PORT_INTERNA=3001
# Limites de /api/chat
# LIMITE_CORPO_BYTES=16384
# LIMITE_POR_MINUTO=20
# MAX_CONCORRENTES=4
# Avaliacao: URL do webhook do n8n e espera maxima (ms) pelo workflow ativo
# AVALIACAO_URL=http://127.0.0.1:5678/webhook/chat
# AVALIACAO_ESPERA_MS=60000
