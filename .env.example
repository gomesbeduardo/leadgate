# Chave da API Anthropic. Copie para .env (ignorado pelo git) e preencha.
ANTHROPIC_API_KEY=

# Servico HTTP (compose). PORT = porta publica do chat; PORT_INTERNA = /preparar e /validar,
# so para a rede do compose (nao publicar no host).
# PORT=3000
# PORT_INTERNA=3001
# Limites de /api/chat
# LIMITE_CORPO_BYTES=16384
# LIMITE_POR_MINUTO=20
# MAX_CONCORRENTES=4
# Avaliacao: URL do webhook do n8n e espera maxima (ms) pelo workflow ativo
# AVALIACAO_URL=http://127.0.0.1:5678/webhook/chat
# AVALIACAO_ESPERA_MS=60000
# Falhas e alertas (spec 002). Dados em DADOS_DIR (padrao dados/); no compose, use volume.
# DADOS_DIR=dados
# Painel de demo: expoe GET /falhas, GET /alertas e DELETE /falhas na porta publica
# DEMO_PAINEL=0
# Avaliacao: onde ler/zerar a contagem de falhas (exige DEMO_PAINEL=1 no servico)
# AVALIACAO_FALHAS_URL=http://127.0.0.1:8080/falhas
# Alerta ao vendedor: simulado (log + /alertas) sempre; resend quando ALERTA_CANAL=resend e houver chave
ALERTA_CANAL=
RESEND_API_KEY=
RESEND_BASE_URL=
ALERTA_EMAIL_DE=
ALERTA_EMAIL_PARA=
